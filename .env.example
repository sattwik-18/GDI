# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=gdi_user
POSTGRES_PASSWORD=gdi_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gdi_db

# ─── API ───────────────────────────────────────────────────────────────────────
APP_NAME=GDI Genome Extraction Engine
API_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# ─── Processing ────────────────────────────────────────────────────────────────
RENDERING_DPI=300
PIPELINE_VERSION=1.0.0
SCHEMA_VERSION=1.0.0
FEATURE_VERSION=1.0.0
PROCESSING_VERSION=1.0.0
STORAGE_ROOT=./gdi_storage
TEMP_DIR=./gdi_storage/temp
STEP_TIMEOUT_SECONDS=60.0

# ─── OCR ───────────────────────────────────────────────────────────────────────
# Options: paddleocr | pytesseract
OCR_ENGINE_PROVIDER=pytesseract
OCR_USE_GPU=false
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.5
# TESSERACT_CMD=/usr/bin/tesseract   # Uncomment on Linux

# ─── Vision ────────────────────────────────────────────────────────────────────
VISION_ENABLE_DESKEW=true
VISION_ENABLE_HOMOGRAPHY=true
VISION_ENABLE_COLOR_NORM=true
CANNY_LOWER_THRESHOLD=50
CANNY_UPPER_THRESHOLD=150

# ─── Security ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=104857600
MAX_PAGE_COUNT=500
MAX_IMAGE_DIMENSION_PX=15000

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: json | text
LOG_FORMAT=json
